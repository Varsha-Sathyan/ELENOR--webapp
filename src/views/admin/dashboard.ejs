<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Elenor Admin Dashboard</title>

    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>

    <!-- Sidebar -->
    <aside class="sidebar">

        <h2>ELENOR</h2>

        <p class="admin-label">ADMIN PANEL</p>

        <ul>
            <li><a href="/admin">Dashboard</a></li>

            <li><a href="/admin/users">Users</a></li>

            <li><a href="/admin/products">Products</a></li>

            <li><a href="/admin/orders">Orders</a></li>

            <li><a href="/admin/settings">Settings</a></li>
        </ul>

    </aside>


    <!-- Main Content -->
    <main class="main-content">

        <!-- Header -->
        <header class="header">

            <h1>Dashboard</h1>

            <div class="admin-profile">
                <span>Admin</span>
            </div>

        </header>


        <!-- Welcome Section -->
        <section class="welcome">

            <h2>Welcome to Elenor Admin</h2>

            <p>
                Manage your products, users, and orders
                from one place.
            </p>

        </section>


        <!-- Statistics -->
        <section class="stats">

            <div class="stat-card">

                <h3>Total Users</h3>

                <p>120</p>

            </div>


            <div class="stat-card">

                <h3>Total Products</h3>

                <p>15</p>

            </div>


            <div class="stat-card">

                <h3>Total Orders</h3>

                <p>45</p>

            </div>


            <div class="stat-card">

                <h3>Total Revenue</h3>

                <p>₹25,000</p>

            </div>

        </section>


        <!-- Recent Orders -->
        <section class="orders">

            <h2>Recent Orders</h2>

            <table>

                <thead>

                    <tr>
                        <th>Order ID</th>

                        <th>Customer</th>

                        <th>Product</th>

                        <th>Amount</th>

                        <th>Status</th>
                    </tr>

                </thead>


                <tbody>

                    <tr>

                        <td>#1001</td>

                        <td>Customer 1</td>

                        <td>Hydrating Serum</td>

                        <td>₹499</td>

                        <td>Pending</td>

                    </tr>


                    <tr>

                        <td>#1002</td>

                        <td>Customer 2</td>

                        <td>Vitamin C Serum</td>

                        <td>₹599</td>

                        <td>Completed</td>

                    </tr>


                </tbody>

            </table>

        </section>

    </main>

</body>

</html>