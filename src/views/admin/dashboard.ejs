<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Admin Dashboard | ELENOR</title><link rel="stylesheet" href="/css/admin.css"></head><body>
<%- include('sidebar', { active: 'dashboard' }) %>
<main class="admin-main"><h1>DASHBOARD</h1><section class="stats" aria-label="Dashboard totals"><% for(const stat of [['TOTAL SALES','—','wallet'],['TOTAL REVENUE','—','money'],['TOTAL ORDERS','—','bag'],['TOTAL USERS',totalUsers.toLocaleString('en-IN'),'users']]) { %><article class="stat-card"><h2><%= stat[0] %></h2><div class="stat-icon"><svg><use href="#<%= stat[2] %>"/></svg></div><strong><%= stat[1] %></strong></article><% } %></section><p class="data-note">User count is live. Sales and order analytics will appear when order tracking is connected.</p>
<div class="analytics"><section class="chart-panel revenue"><header><h2>Revenue Trends</h2><span>Last 7 Days</span></header><div class="line-chart"><svg viewBox="0 0 680 380" role="img" aria-label="Revenue chart. No sales data available."><g stroke="#e9e7e5" stroke-width="1"><path d="M70 35H650M70 95H650M70 155H650M70 215H650M70 275H650"/></g><path d="M70 25V320H650" fill="none" stroke="#cfc9c6"/><g fill="#777" font-size="13" font-family="Arial"><text x="45" y="325">0</text><% ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].forEach((day,i)=>{ %><text x="<%= 65+i*94 %>" y="350"><%= day %></text><% }) %></g><text x="360" y="180" text-anchor="middle" fill="#8a8380" font-size="16" font-family="Arial">No revenue data yet</text></svg></div></section>
<section class="chart-panel categories"><header><h2>Top Categories</h2></header><div class="donut" role="img" aria-label="No category sales data"><div>No data<br><small>yet</small></div></div><p class="empty-copy">Category performance will appear after your first tracked sales.</p><div class="legend"><% ['Face Serums','Oils','Night Creams','Toners','Radiance serum','Hair Serums'].forEach((name,i)=>{ %><span><i style="--dot:<%= ['#e63400','#ba2900','#1c201e','#514b4b','#cfc6c7','#e7e7e7'][i] %>"></i><%= name %></span><% }) %></div></section>
<section class="chart-panel brands"><header><h2>Top Brands</h2><span>Market Share</span></header><div class="brand-bars"><p>No brand sales data yet.</p><% ['Face serums','Oils','Night Creams','Radiance serum'].forEach(name=>{ %><div class="bar-label"><span><%= name %></span><span>—</span></div><div class="bar-track"></div><% }) %></div></section></div></main></body></html>
