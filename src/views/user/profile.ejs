<%- include('account-header', {title: 'My Account'}) %>
<main class="account-layout"><aside class="sidebar panel"><div class="identity"><div class="avatar"><% if(account.avatar) { %><img src="<%= account.avatar %>" alt="Your profile photo"><% } else { %><%= initials %><% } %></div><h2><%= account.fullName %></h2><p><%= account.email %></p></div><nav aria-label="Account navigation"><a class="selected" href="/profile"><span>▦</span>Overview</a><button disabled title="Not available yet"><span>▤</span>Order History</button><button disabled title="Not available yet"><span>▣</span>My Wallet</button><button disabled title="Not available yet"><span>♡</span>Wishlist</button><button class="outlined" disabled title="Not available yet"><span>♧</span>Addresses</button><button class="outlined" disabled title="Not available yet"><span>🛒</span>My Cart</button></nav><form action="/logout" method="post" class="logout"><input type="hidden" name="_csrf" value="<%= token %>"><button type="submit">⇥　Logout</button></form></aside>
<section class="overview"><h1>Account <em>Overview</em></h1><% if(success) { %><p class="notice" role="status"><%= success %></p><% } %><section class="panel details"><div class="section-title"><h2>PERSONAL DETAILS</h2><a href="/profile/edit">✎ Edit Profile</a></div><div class="details-grid"><div><span>Name</span><strong><%= account.fullName %></strong></div><div><span>Email</span><strong><%= account.email %></strong></div></div></section>
<section class="panel referral"><div class="section-title"><h2><b>♢</b> REFERRAL</h2><span class="credit">YOUR ELENOR CIRCLE</span></div><p>Share your love of ELENOR with friends. Your personal referral code is ready to share.</p><% const code = 'ELENOR-' + account.id.slice(-8).toUpperCase(); %><div class="referral-grid"><div class="inset"><span>YOUR REFERRAL CODE</span><strong><%= code %></strong><button type="button" data-copy="<%= code %>">▢ Copy Code</button></div><div class="inset"><span>SHARE LINK</span><strong class="share-url" data-referral="<%= code %>">/signup?ref=<%= code %></strong><button type="button" data-copy-referral="<%= code %>">∞ Copy Link</button></div></div><p class="referral-note">Referral rewards and tracking are not available yet.</p><p id="copy-status" role="status" aria-live="polite"></p></section></section></main>
<%- include('account-footer') %>
