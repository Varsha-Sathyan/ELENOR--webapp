<%- include('account-header', {title: 'Edit Profile'}) %>
<main class="edit-layout"><% if(error) { %><p class="error" role="alert"><%= error %></p><% } %><% if(success) { %><p class="notice" role="status"><%= success %></p><% } %>
<section class="panel edit-panel"><h1>Profile <em>Information</em></h1><form action="/profile/edit" method="post" id="details-form"><input type="hidden" name="_csrf" value="<%= token %>"><input type="hidden" name="photo" id="photo-data"><div class="photo-control"><div class="avatar" id="avatar-preview"><% if(account.avatar) { %><img src="<%= account.avatar %>" alt="Your profile photo"><% } else { %><%= initials %><% } %></div><label for="photo-input" class="photo-label">◉<br>UPLOAD NEW PHOTO</label><input type="file" id="photo-input" accept="image/jpeg,image/png,image/webp"><p id="photo-error" role="alert"></p></div><label for="full-name">NAME</label><input id="full-name" name="fullName" value="<%= account.fullName %>" required maxlength="120" autocomplete="name"><label for="account-email">EMAIL ADDRESS</label><div class="email-field"><input id="account-email" value="<%= account.email %>" readonly autocomplete="email"><span>☑ <%= account.emailVerified ? 'VERIFIED' : 'UNVERIFIED' %></span></div><label for="phone">PHONE NUMBER</label><input id="phone" name="phone" type="tel" value="<%= account.phone || '' %>" placeholder="Enter your phone number" maxlength="30" autocomplete="tel"><button class="primary" type="submit">♙　 SAVE PERSONAL DETAILS</button></form></section>
<section class="panel edit-panel security"><h2>Security <em>Settings</em></h2><form action="/profile/password" method="post"><input type="hidden" name="_csrf" value="<%= token %>"><label for="current-password">CURRENT PASSWORD</label><input id="current-password" name="currentPassword" type="password" placeholder="Enter current password" autocomplete="current-password" required><div class="password-grid"><div><label for="new-password">NEW PASSWORD</label><input id="new-password" name="newPassword" type="password" placeholder="Enter new password" minlength="8" autocomplete="new-password" required></div><div><label for="confirm-password">CONFIRM NEW PASSWORD</label><input id="confirm-password" name="confirmPassword" type="password" placeholder="Confirm new password" minlength="8" autocomplete="new-password" required></div></div><button class="primary" type="submit">⚿　 UPDATE PASSWORD</button></form></section><a href="/profile" class="back-link">← BACK TO MY ACCOUNT</a></main>
<%- include('account-footer') %>
